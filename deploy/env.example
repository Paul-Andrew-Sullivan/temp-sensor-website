# Copy to /mnt/user/appdata/thermo/.env on the server (chmod 600). Never commit the real file.

# Shared secret the ESP32 sends in the X-Probe-Token header when posting to /ingest.
PROBE_TOKEN=change-me

# Resend (https://resend.com) API key and verified sender. See docs/resend.md.
RESEND_API_KEY=
ALERT_FROM=Thermometer <thermo@paulandrewsullivan.com>

# 1 = start in demo mode until a real board reports; 0 = start silent.
DEMO_DEFAULT=1
